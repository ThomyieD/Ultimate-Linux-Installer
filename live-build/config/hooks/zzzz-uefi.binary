#!/bin/sh
set -e
# Ensure UEFI boot files exist on the ISO (Ubuntu live-build 3.x syslinux path)
mkdir -p binary/EFI/BOOT binary/boot/grub

if [ -f chroot/usr/lib/grub/x86_64-efi-signed/gcdx64.efi.signed ]; then
  cp chroot/usr/lib/grub/x86_64-efi-signed/gcdx64.efi.signed binary/EFI/BOOT/BOOTX64.EFI
elif [ -f chroot/usr/lib/grub/x86_64-efi/monolithic/grubx64.efi ]; then
  cp chroot/usr/lib/grub/x86_64-efi/monolithic/grubx64.efi binary/EFI/BOOT/BOOTX64.EFI
elif [ -f chroot/usr/lib/shim/shimx64.efi.signed ]; then
  cp chroot/usr/lib/shim/shimx64.efi.signed binary/EFI/BOOT/BOOTX64.EFI
fi

# Minimal GRUB config for live session if none exists
if [ ! -f binary/boot/grub/grub.cfg ]; then
  cat >binary/boot/grub/grub.cfg <<'EOF'
set timeout=5
set default=0
menuentry "Ultimate Linux Installer" {
    linux /live/vmlinuz boot=live components quiet splash hostname=uli-live username=uli
    initrd /live/initrd.img
}
EOF
fi
