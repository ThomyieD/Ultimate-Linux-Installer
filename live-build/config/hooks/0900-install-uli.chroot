#!/bin/sh
set -e
export DEBIAN_FRONTEND=noninteractive

if [ -d /opt/uli/src ]; then
  python3 -m pip install --no-cache-dir \
    "/opt/uli/src" PySide6 PyYAML requests jsonschema psutil \
    || python3 -m pip install --break-system-packages --no-cache-dir \
    "/opt/uli/src" PySide6 PyYAML requests jsonschema psutil \
    || true
fi

cat >/usr/local/bin/uli-start <<'EOF'
#!/bin/sh
export ULI_SIMULATE_DISK=0
export ULI_DRY_RUN=0
export QT_QPA_PLATFORM=xcb
export QT_AUTO_SCREEN_SCALE_FACTOR=1
sleep 1
exec /usr/local/bin/uli --lang de || exec python3 -m uli.main --lang de
EOF
chmod +x /usr/local/bin/uli-start

if [ ! -x /usr/local/bin/uli ]; then
  cat >/usr/local/bin/uli <<'EOF'
#!/bin/sh
exec python3 -m uli.main "$@"
EOF
  chmod +x /usr/local/bin/uli
fi

mkdir -p /etc/xdg/autostart /etc/xdg/openbox
cat >/etc/xdg/autostart/uli.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Ultimate Linux Installer
Exec=/usr/local/bin/uli-start
X-GNOME-Autostart-enabled=true
EOF

cat >/etc/xdg/openbox/autostart <<'EOF'
#!/bin/sh
nm-applet >/dev/null 2>&1 &
/usr/local/bin/uli-start &
EOF
chmod +x /etc/xdg/openbox/autostart

mkdir -p /etc/lightdm
cat >/etc/lightdm/lightdm.conf <<'EOF'
[Seat:*]
autologin-user=uli
autologin-user-timeout=0
user-session=openbox
greeter-session=lightdm-gtk-greeter
EOF

mkdir -p /etc/skel/.config/openbox
cp /etc/xdg/openbox/autostart /etc/skel/.config/openbox/autostart

systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable lightdm.service 2>/dev/null || true
