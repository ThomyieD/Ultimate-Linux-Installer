#!/bin/sh
# Undo live-build start-stop-daemon divert before lb_chroot_dpkg remove
set -e
if [ -e /usr/sbin/start-stop-daemon.distrib ]; then
  rm -f /usr/sbin/start-stop-daemon
  dpkg-divert --rename --remove /usr/sbin/start-stop-daemon 2>/dev/null || true
  if [ ! -e /usr/sbin/start-stop-daemon ] && [ -e /usr/sbin/start-stop-daemon.distrib ]; then
    cp /usr/sbin/start-stop-daemon.distrib /usr/sbin/start-stop-daemon
    chmod 755 /usr/sbin/start-stop-daemon
  fi
fi
